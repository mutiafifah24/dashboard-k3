import pandas as pd
import plotly.express as px
import streamlit as st

st.set_page_config(page_title="Dashboard Inspeksi K3", layout="wide")
st.title("🦺 Dashboard Inspeksi K3")

# Coba baca file CSV data K3
try:
  df = pd.read_csv("data_k3.csv")
except Exception as e:
  st.error(
      "File 'data_k3.csv' tidak ditemukan di GitHub! Pastikan kamu sudah"
      " menguploadnya."
  )
  st.stop()

# Cek nama kolom secara otomatis
col_loc = (
    "Location" if "Location" in df.columns else df.columns[2]
)  # Mengantisipasi beda nama kolom
col_status = (
    "Status" if "Status" in df.columns else df.columns[10]
)  # Mengantisipasi beda nama kolom
col_cat = "Category" if "Category" in df.columns else df.columns[5]

# Filter Sidebar
st.sidebar.header("Filter Data")
lokasi = st.sidebar.multiselect(
    "Pilih Lokasi:", options=df[col_loc].unique(), default=df[col_loc].unique()
)
status = st.sidebar.multiselect(
    "Pilih Status:",
    options=df[col_status].unique(),
    default=df[col_status].unique(),
)

df_filtered = df[(df[col_loc].isin(lokasi)) & (df[col_status].isin(status))]

# Metrik Utama (Cards)
col1, col2, col3, col4 = st.columns(4)
col1.metric("Total Temuan", len(df_filtered))
col2.metric(
    "Open", len(df_filtered[df_filtered[col_status] == "Open"])
)
col3.metric(
    "On Progress", len(df_filtered[df_filtered[col_status] == "Progress"])
)
col4.metric(
    "Closed", len(df_filtered[df_filtered[col_status] == "Closed"])
)

st.markdown("---")

# Grafik Visualisasi
col_chart1, col_chart2 = st.columns(2)

with col_chart1:
  st.subheader("Temuan Berdasarkan Kategori")
  fig_cat = px.bar(
      df_filtered,
      x=col_cat,
      color=col_status,
      barmode="group",
      title="Jumlah Temuan per Kategori",
  )
  st.plotly_chart(fig_cat, use_container_width=True)

with col_chart2:
  st.subheader("Distribusi Status Temuan")
  fig_pie = px.pie(
      df_filtered,
      names=col_status,
      title="Persentase Status Temuan",
      hole=0.4,
  )
  st.plotly_chart(fig_pie, use_container_width=True)

# Tabel Data
st.subheader("📋 Detail Data Temuan")
st.dataframe(df_filtered)
